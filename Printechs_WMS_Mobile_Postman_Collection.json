    {
      "name": "13. Transfer In",
      "item": [
        {
          "name": "Get Transfer Ins",
          "request": {
            "method": "GET",
            "url": "{{http://localhost:3000}}/api/transfer-in?status=Submitted"
          }
        },
        {
          "name": "Get Transfer In",
          "request": {
            "method": "GET",
            "url": "{{http://localhost:3000}}/api/transfer-in/{{title}}"
          }
        },
        {
          "name": "Create Transfer In",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_showroom\": \"SR-01\",\n  \"to_warehouse\": \"WH-001\",\n  \"items\": []\n}"
            },
            "url": "{{http://localhost:3000}}/api/transfer-in"
          }
        },
        {
          "name": "Submit Transfer In",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{http://localhost:3000}}/api/transfer-in/{{title}}/submit"
          }
        },
        {
          "name": "Update Transfer In Status",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Transit\"\n}"
            },
            "url": "{{http://localhost:3000}}/api/transfer-in/{{title}}/update-status"
          }
        },
        {
          "name": "Complete Transfer In Receiving",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completed_by\": \"USER-001\"\n}"
            },
            "url": "{{http://localhost:3000}}/api/transfer-in/{{title}}/complete-receiving"
          }
        },
        {
          "name": "Receive Transfer In Line",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carton_id\": \"CTN-001\",\n  \"item_code\": \"ITEM-001\",\n  \"received_qty\": 10,\n  \"received_by\": \"USER-001\"\n}"
            },
            "url": "{{http://localhost:3000}}/api/transfer-in/{{title}}/receive-line"
          }
        },
        {
